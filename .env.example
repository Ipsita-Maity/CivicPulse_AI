# ============================================================================
# CivicPulse AI: Environment Configuration
# ============================================================================

# Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="CivicPulse AI"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Sovereign Database (PostgreSQL + PostGIS)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=civicpulse_admin
POSTGRES_PASSWORD=SovereignCivicPulse2026!
POSTGRES_DB=civicpulse_db
DATABASE_URL="postgresql+asyncpg://civicpulse_admin:SovereignCivicPulse2026!@localhost:5432/civicpulse_db"

# Redis Cache & Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=SovereignRedis2026!
REDIS_URL="redis://:SovereignRedis2026!@localhost:6379/0"

# Security & JWT Secrets
JWT_SECRET_KEY="sovereign-civicpulse-ai-brics-super-secret-key-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Microservice Configuration
AI_SERVICE_URL="http://localhost:8001"
WHISPER_MODEL_SIZE="large-v3"
ENABLE_LOCAL_EMBEDDINGS=true

# Optional External Cloud Model Keys (Decision Support & Chatbot)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_TOKEN=

# Sovereign Multilateral Nodes Whitelist (CORS)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"
